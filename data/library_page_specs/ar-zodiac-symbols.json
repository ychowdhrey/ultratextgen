  "faq_h2": "أسئلة شائعة عن رموز الابراج",
  "faq": [
    {
      "q": "هل تعمل في البايو على انستقرام؟",
      "a": "نعم. هي حروف يونيكود عادية لا صور، فتُلصق في أي مكان يقبل النص. أما في اسم المستخدم (@) فغالبًا ما تُرفض."
    },
    {
      "q": "لماذا يظهر الرمز أسود أحيانًا وملونًا أحيانًا؟",
      "a": "بعض الأنظمة تتعامل مع ♈ كحرف نصي وبعضها كإيموجي ملون. الحرف واحد، والاختلاف في طريقة الرسم فقط."
    },
    {
      "q": "ما هو برج الحواء؟",
      "a": "أوفيوخوس، كوكبة ثالثة عشرة تمر بها الشمس. التنجيم الغربي يعتمد تقليديًا اثني عشر برجًا، لذلك أُدرج هنا بوصفه غير رسمي."
    },
    {
      "q": "لماذا يتكرر رمز عطارد مرتين؟",
      "a": "☿ يرمز إلى كوكب عطارد وإلى الزئبق في الخيمياء معًا — تاريخيًا هو الرمز نفسه في سياقين."
    },
    {
      "q": "هل أستطيع استخدامها في اسم اللعبة؟",
      "a": "بعض الألعاب تسمح بها وبعضها يحذف كل ما هو خارج الحروف اللاتينية. جرّبها قبل تثبيت الاسم، فبطاقة تغيير الاسم مدفوعة غالبًا."
    }
  ],
  "editorial_sections": [
    {
      "h2": "لماذا صارت رموز الابراج حروفًا أصلًا",
      "body": "جاءت رموز الأبراج والكواكب من المخطوطات الفلكية والخيميائية، حيث كانت تُركَّب مثل الحروف تمامًا على مدى قرون. ولهذا السبب دخلت يونيكود: لا للزينة بل ليتمكن الباحثون من صفّ النصوص الفلكية. وهذا نفسه يفسر اختلاف الظهور — نظام يعامل ♈ بوصفه حرفًا فيرسمه أسود، وآخر يعامله بوصفه صورة فيعرضه إيموجي ملونًا."
    }
  ],
