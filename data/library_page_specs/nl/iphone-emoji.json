  "faq_h2": "Veelgestelde Vragen over iPhone Emoji",
  "faq": [
    {
      "q": "Zijn iPhone-emoji's anders dan Android-emoji's?",
      "a": "Nee, het zijn dezelfde tekens — dezelfde Unicode-standaard. Alleen de tekening verschilt: Apple heeft zijn eigen stijl, Google de zijne. Een emoji die je hier kopieert komt op allebei goed aan."
    },
    {
      "q": "Waarom zien mijn emoji's er op Android anders uit?",
      "a": "Omdat Android ze tekent met de set van Google in plaats van die van Apple. De boodschap is identiek, het plaatje niet. Het is geen fout en geen verkeerd teken."
    },
    {
      "q": "Kan ik iPhone-emoji's kopiëren vanaf een computer of Android?",
      "a": "Ja. Je kopieert hier het teken en niet een afbeelding — dat werkt overal. Bij de ontvanger verschijnt het in de stijl van diens toestel."
    },
    {
      "q": "Waarom zie ik een blokje of vraagteken in plaats van een emoji?",
      "a": "Het toestel kent dat teken nog niet, meestal omdat het besturingssysteem oud is. Dat gebeurt vooral bij pas toegevoegde emoji's: het teken klopt en verschijnt wel op een bijgewerkt toestel."
    },
    {
      "q": "Bestaat er een Apple-lettertype om iPhone-emoji's op Android te krijgen?",
      "a": "Nee, en wees voorzichtig met apps die dat beloven. Emoji's horen bij het besturingssysteem; voor de Apple-tekeningen heb je een Apple-toestel nodig."
    }
  ],
  "editorial_sections": [
    {
      "h2": "iPhone en Android: Dezelfde Emoji, Andere Tekening",
      "body": "Als je 😂 vanaf een iPhone stuurt, verstuur je geen plaatje maar een Unicode-code: U+1F602. De telefoon die hem ontvangt tekent hem met zijn eigen set — Apple, Google, Samsung of WhatsApp. Het uiterlijk verschilt dus, de betekenis niet. Alleen een emoji die te nieuw is voor het systeem van de ontvanger gaat echt mis: dan verschijnt een blokje, en een update lost het op."
    }
  ],
