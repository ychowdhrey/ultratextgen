  "faq_h2": "أسئلة شائعة عن ايموجي الايفون",
  "faq": [
    {
      "q": "هل ايموجي الايفون مختلفة عن اندرويد؟",
      "a": "الرموز نفسها تمامًا — نفس معيار يونيكود. الاختلاف في الرسم فقط: لابل أسلوبها ولجوجل أسلوبها. الايموجي المنسوخة من هنا تصل سليمة إلى الجهازين."
    },
    {
      "q": "لماذا يظهر شكل الايموجي مختلفًا على اندرويد؟",
      "a": "لأن اندرويد يرسمها بمجموعة جوجل لا بمجموعة ابل. المحتوى واحد والرسم مختلف، وليس في الأمر خطأ ولا رمز تالف."
    },
    {
      "q": "هل أستطيع نسخ ايموجي الايفون من كمبيوتر أو من اندرويد؟",
      "a": "نعم. ما يُنسخ هنا رمز لا صورة، فيعمل في أي مكان، ويظهر عند المستلم بأسلوب جهازه هو."
    },
    {
      "q": "لماذا تظهر الايموجي مربعًا أو علامة استفهام؟",
      "a": "الجهاز لا يعرف هذا الرمز بعد، غالبًا بسبب قدم نظام التشغيل. يحدث هذا كثيرًا مع الايموجي المضافة حديثًا: الرمز صحيح وسيظهر على جهاز محدّث."
    },
    {
      "q": "هل يوجد خط من ابل لإظهار ايموجي الايفون على اندرويد؟",
      "a": "لا، والأفضل الحذر من التطبيقات التي تعد بذلك. الايموجي جزء من نظام التشغيل، ولرؤيتها برسم ابل يلزم جهاز من ابل."
    }
  ],
  "editorial_sections": [
    {
      "h2": "الايفون واندرويد: الايموجي نفسها برسم مختلف",
      "body": "حين ترسل 😂 من الايفون فأنت لا ترسل صورة بل رمز يونيكود هو U+1F602، والهاتف المستقبِل يرسمه بمجموعته الخاصة — ابل أو جوجل أو سامسونج أو واتساب. لذلك يتغير الشكل ولا يتغير المعنى. الحالة الوحيدة التي تفسد فعلًا هي ايموجي أحدث من نظام المستقبِل، فيظهر مربع، ويكفي التحديث لحلها."
    }
  ],
