      "text": "Feliz Halloween",
      "group": "Saludos clásicos",
      "translation": "El saludo que siempre funciona."
    },
    {
      "text": "Dulce o truco",
      "group": "Saludos clásicos",
      "translation": "El clásico de puerta en puerta."
    },
    {
      "text": "¡Buu!",
      "group": "Saludos clásicos",
      "translation": "Corto y reutilizable."
    },
    {
      "text": "Feliz Noche de Brujas",
      "group": "Saludos clásicos",
      "translation": "La versión en español que se usa en gran parte de Latinoamérica."
    },
    {
      "text": "Que empiece el terror",
      "group": "Saludos clásicos",
      "translation": "Para abrir la noche."
    },
    {
      "text": "¡Feliz Halloween para ti también!",
      "group": "Respuestas",
      "translation": "Respuesta directa."
    },
    {
      "text": "Igualmente — que la noche te dé miedo del bueno",
      "group": "Respuestas",
      "translation": "Respuesta juguetona."
    },
    {
      "text": "Feliz Halloween para toda la familia",
      "group": "Para la familia",
      "translation": "Sirve para niños y adultos."
    },
    {
      "text": "Que tu noche sea de dulces y no de sustos",
      "group": "Para la familia",
      "translation": "Mensaje cálido de familia."
    },
    {
      "text": "Feliz primer Halloween, pequeño",
      "group": "Para la familia",
      "translation": "Para el primer Halloween de un bebé."
    },
    {
      "text": "Ven por los disfraces, quédate por los dulces",
      "group": "Para amigos",
      "translation": "Para invitar al grupo."
    },
    {
      "text": "Si lo tienes, asústalo",
      "group": "Para amigos",
      "translation": "Frase divertida para una foto de disfraz."
    },
    {
      "text": "Vengo por los dulces, no por los sustos",
      "group": "Para amigos",
      "translation": "Para quien odia el terror."
    },
    {
      "text": "Esta noche mando yo, soy la bruja",
      "group": "Para amigos",
      "translation": "Frase juguetona de disfraz."
    },
    {
      "text": "Feliz Halloween de parte de todo el equipo",
      "group": "Formal y trabajo",
      "translation": "Seguro para un mensaje de empresa."
    },
    {
      "text": "Que tengas un Halloween divertido y seguro",
