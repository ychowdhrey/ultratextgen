  "handoff_targets": {
    "general_generator": {
      "path": "/",
      "kind": "generator",
      "text_param": "q",
      "fixed_params": [],
      "verified": "?q= prefills #mainInput"
    },
    "text_decorator": {
      "path": "/category/text-decorator/",
      "kind": "generator",
      "text_param": "q",
      "fixed_params": [
        "vibe",
        "dsym",
        "dfont"
      ],
      "verified": "?q= prefills; vibe must be a decoratorData.js theme key"
    },
    "cursive_fonts": {
      "path": "/category/cursive-fonts/",
      "kind": "generator",
      "text_param": "q",
      "fixed_params": [],
      "verified": "?q= prefills"
