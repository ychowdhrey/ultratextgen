      "kind": "generator",
      "text_param": "q",
      "fixed_params": [],
      "verified": "?q= prefills"
    },
    "zalgo": {
      "path": "/usecase/zalgo-text/",
      "kind": "effect",
      "text_param": "text",
      "fixed_params": [],
      "max_len": 500,
      "verified": "?text= prefills (zalgo-text.js); ?q= is ignored"
    },
    "word_search": {
      "path": "/printables/word-search-maker/",
      "kind": "activity",
