        "experience.handoffs[kind=cursive]"
      ],
      "head_term_owner": "printables/ cursive sheets"
    },
    {
      "id": "coloring_banner",
      "label": "Coloring and banner outputs",
      "implementation": "section:handoffs (kind coloring or banner)",
      "requires": [
        "experience.handoffs[kind in coloring, banner]"
      ],
      "head_term_owner": "printables/ makers"
    },
    {
      "id": "copy_share",
      "label": "Copy and sharing",
      "implementation": "component:copy + share-core",
      "requires": [],
