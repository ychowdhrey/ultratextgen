{
  "_about": "The occasion capability registry. Every /events/ page declares, in its spec's `experience.capabilities`, each capability below as enabled (true) or disabled with a reason. The generator renders a section only for an enabled capability; scripts/check-event-capabilities.js fails when an enabled capability has no data or implementation, when a disabled one still has data that would render, or when a hand-off names a target or parameter this file does not define. docs/events-capability-matrix.md is generated from the specs and this file.",
  "version": 1,
  "capabilities": [
    {
      "id": "styled_fonts",
      "label": "Styled fonts and text",
      "implementation": "section:fonts",
      "requires": [
        "fonts.curated_keys"
      ],
      "head_term_owner": "events (occasion font queries); the general generator keeps generic font queries"
    },
    {
      "id": "compositions",
      "label": "Decorative frames and compositions",
      "implementation": "section:compositions",
      "requires": [
        "experience.compositions"
      ],
      "head_term_owner": "events"
    },
    {
      "id": "occasion_symbols",
      "label": "Occasion-specific symbols",
      "implementation": "section:symbols",
      "requires": [
        "emoji_symbol_collections"
      ],
      "head_term_owner": "library/ (the occasion's symbol page)"
    },
    {
      "id": "emoji_kaomoji",
      "label": "Emoji and kaomoji",
      "implementation": "section:kaomoji",
      "requires": [
        "kaomoji"
      ],
      "head_term_owner": "library/ (kaomoji pages)"
    },
    {
      "id": "ascii_art",
      "label": "ASCII art",
      "implementation": "section:ascii",
      "requires": [
        "ascii_art.items"
      ],
      "head_term_owner": "library/ (ASCII art pages)"
